+export const E_INK_CODE_COLORS = {
+  background: "#ffffff",
+  text: "#000000",
+  addBar: "#00B036",
+  deleteBar: "#FF6163",
+  addBackground: "#CFEFD9",
+  deleteBackground: "#FFD7D8",
+  addHighlight: "#B5E7C5",
+  deleteHighlight: "#FFB0B1",
+  hunkBackground: "#dddddd",
+} as const;
+
+export function eInkChangeBackground(change: "add" | "delete" | "context") {
+  return change === "add"
+    ? E_INK_CODE_COLORS.addBackground
+    : change === "delete"
+      ? E_INK_CODE_COLORS.deleteBackground
+      : E_INK_CODE_COLORS.background;
+}
+
+export function eInkTokenStyle(token: string): readonly [string, number] {
+  const fontStyle = token.startsWith("comment")
+    ? 3
+    : /^(function|variable)(\.|$)/.test(token) || token === "type.class"
+      ? 2
+      : /^(string|number|boolean|constant)(\.|$)/.test(token)
+        ? 1
+        : 0;
+  return [E_INK_CODE_COLORS.text, fontStyle];
+}
+
+export function codeTokenTextStyle(fontStyle: number | null, scheme: "light" | "dark") {
+  const flags = fontStyle ?? 0;
+  return {
+    fontWeight:
+      flags & 2 ? ("700" as const) : scheme === "light" ? ("500" as const) : ("400" as const),
+    fontStyle: flags & 1 ? ("italic" as const) : ("normal" as const),
+  };
+}
